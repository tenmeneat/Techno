# cp .env.example .env 후 채운다. .env는 커밋 금지.

# MQTT — 운영 브로커(HiveMQ Cloud Serverless). 1주차부터 여기에 직접 붙여 개발 (§11.2)
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=dg-server
MQTT_PASS=
# 오프라인 작업(로컬 Mosquitto) 시:
# MQTT_HOST=mosquitto  MQTT_PORT=1883  MQTT_TLS=false  MQTT_USER=  MQTT_PASS=

API_TOKEN=
CORS_ORIGINS=http://localhost:3000

# 외기온 (§4.5) — 기상청 API허브 마이페이지에서 발급. 비워두면 Open-Meteo만 사용
KMA_AUTH_KEY=
KMA_STN=108
REGION_CODE=seoul
LAT=37.5714
LON=126.9658

# Web Push — `npx web-push generate-vapid-keys` 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
