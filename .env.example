# cp .env.example .env 후 채운다. .env는 커밋 금지.

# MQTT - local Docker Mosquitto: docker compose --profile offline up -d
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USER=
MQTT_PASS=
# For HiveMQ Cloud, set your host, port 8883, TLS true and credentials in .env.

API_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

# 외기온 (§4.5) — 기상청 API허브 마이페이지에서 발급. 비워두면 Open-Meteo만 사용
KMA_AUTH_KEY=
KMA_STN=108
REGION_CODE=seoul
LAT=37.5714
LON=126.9658

# Web Push — `npx web-push generate-vapid-keys` 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
